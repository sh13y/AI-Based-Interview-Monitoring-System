# ============================================================
# Modern Matrix — .gitignore
# ============================================================

# Dependencies
node_modules/

# Build output
frontend/dist/
frontend/dist-ssr/

# Environment variables (contains secrets)
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python (backend — future use)
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
*.egg-info/

# Misc
*.local
.vercel/
.netlify/
