# ============================================================
# Modern Matrix — Environment Variables
# ============================================================
# Copy this file to `.env.local` and fill in your Supabase credentials.
# If no keys are set, the app runs in Demo Mode with mock data.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Whisper ASR Model API (Cloudflare Tunnel URL)
# Set this to your active Cloudflare tunnel endpoint, e.g.:
# VITE_WHISPER_API_URL=https://your-cloudflare-link.trycloudflare.com/predict
VITE_WHISPER_API_URL=

# Behavioral Evaluation Model API (Colab Cloudflare Tunnel BASE URL)
# Set this to your active Cloudflare tunnel base URL (without /predict), e.g.:
# VITE_BEHAVIORAL_API_URL=https://your-cloudflare-link.trycloudflare.com
VITE_BEHAVIORAL_API_URL=
